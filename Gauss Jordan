#include <stdio.h>

int main() {
    int i, j, k;
    float A[3][4] = {
        {20, 5, -2, 14},
        {3, 10, 1, 17},
        {2, -4, 10, 23}
    };
    float ratio;

    // Gauss-Jordan Elimination
    for(i = 0; i < 3; i++) {
        // Make diagonal element 1
        float pivot = A[i][i];
        for(j = 0; j < 4; j++) {
            A[i][j] = A[i][j] / pivot;
        }

        // Make other elements 0
        for(j = 0; j < 3; j++) {
            if(j != i) {
                ratio = A[j][i];
                for(k = 0; k < 4; k++) {
                    A[j][k] = A[j][k] - ratio * A[i][k];
                }
            }
        }
    }

    printf("Solution:\n");
    printf("x1 = %.3f\n", A[0][3]);
    printf("x2 = %.3f\n", A[1][3]);
    printf("x3 = %.3f\n", A[2][3]);

    return 0;
}
